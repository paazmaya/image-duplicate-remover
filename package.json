    "url": "https://paazmaya.fi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paazmaya/image-duplicate-remover.git"
  },
  "bugs": {
    "url": "https://github.com/paazmaya/image-duplicate-remover/issues"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "chalk": "~2.4.1",
    "hasha": "~3.0.0",
    "image-extensions": "~1.1.0",
    "optionator": "0.9.4",
    "readline-sync": "~1.4.9"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "oxlint": "1.91.0",
    "tape": "5.10.3"
  }
